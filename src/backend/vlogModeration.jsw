// backend/vlogModeration.jsw
// Moderation actions for the Vlogs collection.
//
// IMPORTANT: wixData.update() REPLACES the whole item — it is not a
// partial update. Every write here therefore reads the record first
// and spreads it into the update, so untouched fields survive.

import wixData from 'wix-data';
import { currentMember } from 'wix-members-backend';

const ADMIN_ROLE_NAMES = ['Admin', 'Owner', 'Administrator', 'Moderator'];
const ADMIN_EMAILS = ['darkworld_55@hotmail.com'];
const ALLOWED_STATUSES = ['Pending', 'Approved', 'Rejected'];

/**
 * Diagnostic helper — call from page code and read the console if
 * access is denied unexpectedly.
 */
export async function debugAccess() {
  try {
    const member = await currentMember.getMember();
    let roles = [];
    try {
      roles = await currentMember.getRoles();
    } catch (roleErr) {
      return {
        loggedIn: !!member,
        email: member ? member.loginEmail : null,
        roles: [],
        roleError: String(roleErr && roleErr.message)
      };
    }
    return {
      loggedIn: !!member,
      memberId: member ? member._id : null,
      email: member ? member.loginEmail : null,
      roles: roles.map((r) => r.title)
    };
  } catch (err) {
    return { loggedIn: false, error: String(err && err.message) };
  }
}

export async function isCurrentMemberAdmin() {
  let member;
  try {
    member = await currentMember.getMember();
  } catch (err) {
    console.error('Member lookup failed', err);
    return false;
  }
  if (!member) return false;

  const email = (member.loginEmail || '').toLowerCase();
  if (email && ADMIN_EMAILS.includes(email)) return true;

  try {
    const roles = await currentMember.getRoles();
    return roles.some((r) => ADMIN_ROLE_NAMES.includes(r.title));
  } catch (err) {
    console.error('Role lookup failed', err);
    return false;
  }
}

async function assertAdmin() {
  const ok = await isCurrentMemberAdmin();
  if (!ok) throw new Error('not_authorized');
}

/**
 * Reads the record and writes it back with only the given fields
 * changed. This is the only safe way to "patch" a Wix collection item.
 *
 * @param {string} vlogId
 * @param {object} changes
 */
async function patchVlog(vlogId, changes) {
  const existing = await wixData.get('Vlogs', vlogId, { suppressAuth: true });
  if (!existing) throw new Error('vlog_not_found');

  const merged = Object.assign({}, existing, changes);
  return wixData.update('Vlogs', merged, { suppressAuth: true });
}

/**
 * Lists vlogs by status, newest first.
 */
export async function getVlogsByStatus(status = 'Pending', limit = 50) {
  await assertAdmin();

  const safeStatus = ALLOWED_STATUSES.includes(status) ? status : 'Pending';

  const result = await wixData
    .query('Vlogs')
    .eq('status', safeStatus)
    .descending('submissionDate')
    .limit(limit)
    .find({ suppressAuth: true });

  return result.items;
}

export async function approveVlog(vlogId, note = '') {
  await assertAdmin();
  return patchVlog(vlogId, {
    status: 'Approved',
    moderatorNote: note,
    reviewedDate: new Date()
  });
}

export async function rejectVlog(vlogId, note = '') {
  await assertAdmin();
  return patchVlog(vlogId, {
    status: 'Rejected',
    moderatorNote: note,
    reviewedDate: new Date()
  });
}

export async function getPendingCount() {
  await assertAdmin();
  const { totalCount } = await wixData
    .query('Vlogs')
    .eq('status', 'Pending')
    .find({ suppressAuth: true });
  return totalCount;
}
