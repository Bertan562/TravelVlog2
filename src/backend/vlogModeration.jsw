// backend/vlogModeration.jsw
// Moderation actions for the Vlogs collection.
// The admin check lives here (not only on the page) so a non-admin
// can't approve their own vlog by calling the backend directly.

import wixData from 'wix-data';
import { currentMember } from 'wix-members-backend';

// Wix reports member roles inconsistently depending on how the role was
// created, and the site owner often has no member role at all — so the
// check accepts any of these names, plus an explicit email allowlist.
const ADMIN_ROLE_NAMES = ['Admin', 'Owner', 'Administrator', 'Moderator'];

// Fallback for the site owner. Add any address that should always have
// moderation access, lowercase.
const ADMIN_EMAILS = ['darkworld_55@hotmail.com'];

const ALLOWED_STATUSES = ['Pending', 'Approved', 'Rejected'];

/**
 * Diagnostic helper — call this from the page code and read the console
 * if access is being denied unexpectedly. It shows exactly what Wix
 * reports for the logged-in member.
 */
export async function debugAccess() {
  try {
    const member = await currentMember.getMember();
    let roles = [];
    try {
      roles = await currentMember.getRoles();
    } catch (roleErr) {
      return {
        loggedIn: !!member,
        email: member ? member.loginEmail : null,
        roles: [],
        roleError: String(roleErr && roleErr.message)
      };
    }
    return {
      loggedIn: !!member,
      memberId: member ? member._id : null,
      email: member ? member.loginEmail : null,
      roles: roles.map((r) => r.title)
    };
  } catch (err) {
    return { loggedIn: false, error: String(err && err.message) };
  }
}

/**
 * True if the logged-in member may moderate.
 */
export async function isCurrentMemberAdmin() {
  let member;
  try {
    member = await currentMember.getMember();
  } catch (err) {
    console.error('Member lookup failed', err);
    return false;
  }
  if (!member) return false;

  // Email allowlist first — this works even when Wix returns no roles.
  const email = (member.loginEmail || '').toLowerCase();
  if (email && ADMIN_EMAILS.includes(email)) return true;

  try {
    const roles = await currentMember.getRoles();
    return roles.some((r) => ADMIN_ROLE_NAMES.includes(r.title));
  } catch (err) {
    console.error('Role lookup failed', err);
    return false;
  }
}

async function assertAdmin() {
  const ok = await isCurrentMemberAdmin();
  if (!ok) throw new Error('not_authorized');
}

/**
 * Lists vlogs by status, newest first.
 * @param {'Pending'|'Approved'|'Rejected'} status
 * @param {number} limit
 */
export async function getVlogsByStatus(status = 'Pending', limit = 50) {
  await assertAdmin();

  const safeStatus = ALLOWED_STATUSES.includes(status) ? status : 'Pending';

  const result = await wixData
    .query('Vlogs')
    .eq('status', safeStatus)
    .descending('submissionDate')
    .limit(limit)
    .find({ suppressAuth: true });

  return result.items;
}

/**
 * Approves a vlog. The author's approved count is derived from this
 * status, so no separate counter needs updating.
 */
export async function approveVlog(vlogId, note = '') {
  await assertAdmin();
  return wixData.update(
    'Vlogs',
    { _id: vlogId, status: 'Approved', moderatorNote: note, reviewedDate: new Date() },
    { suppressAuth: true }
  );
}

/**
 * Rejects a vlog. The record stays so the author can see why, and so
 * repeat offenders stay traceable.
 */
export async function rejectVlog(vlogId, note = '') {
  await assertAdmin();
  return wixData.update(
    'Vlogs',
    { _id: vlogId, status: 'Rejected', moderatorNote: note, reviewedDate: new Date() },
    { suppressAuth: true }
  );
}

/**
 * Counts how many vlogs are waiting, for a badge in the header.
 */
export async function getPendingCount() {
  await assertAdmin();
  const { totalCount } = await wixData
    .query('Vlogs')
    .eq('status', 'Pending')
    .find({ suppressAuth: true });
  return totalCount;
}
