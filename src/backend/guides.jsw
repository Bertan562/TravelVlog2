import wixData from 'wix-data';

/**
 * Guides koleksiyonundaki tüm rehberleri getirir.
 * Kart listesi için gereken alanlar: title, slug, kisaAciklama, ulke, bolge, heroImage
 */
export async function getAllGuides() {
    try {
        const results = await wixData.query('Guides')
            .descending('tarih')
            .limit(100)
            .find();

        return results.items.map(item => ({
            _id: item._id,
            title: item.title || '',
            slug: item.slug || '',
            kisaAciklama: item.kisaAciklama || '',
            ulke: item.ulke || '',
            bolge: item.bolge || '',
            heroImage: item.heroImage || ''
        }));
    } catch (error) {
        console.error('[Guides] getAllGuides error:', error);
        return [];
    }
}
