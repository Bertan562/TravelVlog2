// backend/vlogSubmission.jsw
// Handles trust-level lookup and the actual Vlogs collection insert.
// Keeping this on the backend means a member can't fake their own
// trust level, skip the agreement, or forge a status by tampering
// with client-side calls.

import wixData from 'wix-data';
import { currentMember } from 'wix-members-backend';
import { recordPlace } from 'backend/vlogPlaces';
import { getAgreementStatus } from 'backend/vlogAgreement';

const TRUSTED_THRESHOLD = 3; // approved vlogs needed before auto-publish

/**
 * Looks at how many of this member's past vlogs were approved and
 * decides the initial status for a new submission.
 * @param {string} memberId
 */
async function determineInitialStatus(memberId) {
  const { totalCount } = await wixData
    .query('Vlogs')
    .eq('author', memberId)
    .eq('status', 'Approved')
    .find({ suppressAuth: true });

  if (totalCount >= TRUSTED_THRESHOLD) {
    return { status: 'Approved', trustLevel: 'trusted' };
  }
  return { status: 'Pending', trustLevel: 'new' };
}

/**
 * Submits a new vlog (video or gallery) to the Vlogs collection.
 * @param {object} vlogInput
 */
export async function submitVlog(vlogInput) {
  const member = await currentMember.getMember();
  if (!member) throw new Error('not_logged_in');

  // The agreement is the legal basis for publishing the content, so it
  // is checked here rather than trusting the form's own gating.
  const agreement = await getAgreementStatus();
  if (!agreement.signed) throw new Error('agreement_not_signed');

  if (vlogInput.contentType === 'video' && !vlogInput.videoUrl) {
    throw new Error('missing_video_url');
  }
  if (
    vlogInput.contentType === 'gallery' &&
    (!vlogInput.galleryImages || vlogInput.galleryImages.length < 3)
  ) {
    throw new Error('gallery_too_short');
  }
  if (!vlogInput.destinationName || !vlogInput.destinationName.trim()) {
    throw new Error('missing_destination');
  }

  // Typed place names go into their own collection so duplicates merge
  // and an admin can later link them to real Destinations entries.
  const destinationPlace = await recordPlace(vlogInput.destinationName, 'destination');
  const experiencePlace = vlogInput.experienceName
    ? await recordPlace(vlogInput.experienceName, 'experience')
    : null;

  const { status, trustLevel } = await determineInitialStatus(member._id);

  const record = {
    title: vlogInput.title,
    slug: vlogInput.slug,
    contentType: vlogInput.contentType,
    description: vlogInput.description,
    coverImage: vlogInput.coverImage,

    videoUrl: vlogInput.videoUrl || '',
    videoPlatform: vlogInput.videoPlatform || '',
    videoTitle: vlogInput.videoTitle || '',
    channelName: vlogInput.channelName || '',

    galleryImages: vlogInput.galleryImages || [],
    galleryImageCount: vlogInput.galleryImages ? vlogInput.galleryImages.length : 0,

    // Free text as the member typed it, plus the normalised record it
    // resolved to. Keeping both means the page can show their wording
    // while still grouping vlogs by place.
    destinationName: vlogInput.destinationName.trim(),
    destinationPlace: destinationPlace ? destinationPlace._id : null,
    experienceName: (vlogInput.experienceName || '').trim(),
    experiencePlace: experiencePlace ? experiencePlace._id : null,

    instagramHandle: (vlogInput.instagramHandle || '').trim(),

    author: member._id,
    status,
    trustLevelAtSubmission: trustLevel,
    agreementVersion: agreement.version,
    reportCount: 0,
    submissionDate: new Date(),
    moderatorNote: vlogInput.channelNameMismatch
      ? 'Flagged: channel name mismatch at submission'
      : ''
  };

  const inserted = await wixData.insert('Vlogs', record, { suppressAuth: true });
  return { inserted, status };
}

/**
 * Increments the report count on a vlog and flips it back to Pending
 * once it crosses the threshold, so it disappears from public view
 * until a moderator re-checks it.
 * @param {string} vlogId
 */
export async function reportVlog(vlogId) {
  const REPORT_THRESHOLD = 3;
  const vlog = await wixData.get('Vlogs', vlogId, { suppressAuth: true });
  if (!vlog) throw new Error('vlog_not_found');

  const newCount = (vlog.reportCount || 0) + 1;
  const update = { _id: vlogId, reportCount: newCount };

  if (newCount >= REPORT_THRESHOLD && vlog.status === 'Approved') {
    update.status = 'Pending';
    update.moderatorNote = `${vlog.moderatorNote || ''} | Auto re-flagged after ${newCount} reports`.trim();
  }

  return wixData.update('Vlogs', update, { suppressAuth: true });
}
